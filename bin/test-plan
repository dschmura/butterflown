#!/usr/bin/env ruby
# Usage: bin/test-plan [--base REF] [--github-output] [--run [--dry-run]] | --green-skip [--github-output]
# Prints this branch's change lanes and the specs they select; see /docs/developer/testing.
require "optparse"
require "open3"
require "json"
require_relative "../lib/change_lanes"
require_relative "../lib/clean_git_env"

options = {}
OptionParser.new do |parser|
  parser.on("--base REF") { |ref| options[:base] = ref }
  parser.on("--github-output") { options[:github_output] = true }
  parser.on("--run") { options[:run] = true }
  parser.on("--dry-run") { options[:dry_run] = true }
  parser.on("--green-skip") { options[:green_skip] = true }
end.parse!

def git(*args)
  out, status = Open3.capture2(CleanGitEnv::HASH, "git", *args)
  abort "test-plan: git #{args.join(" ")} failed" unless status.success?
  out
end

def ref?(ref)
  system(CleanGitEnv::HASH, "git", "rev-parse", "--verify", "--quiet", "#{ref}^{commit}", out: File::NULL)
end

def changelog_only?(diff)
  diff.lines(chomp: true).all? do |line|
    status, path = line.split("\t", 2)
    path == "CHANGELOG.md" ? status != "D" : path.match?(%r{\Achangelog\.d/(?!README\.md\z)[^/]+\.md\z})
  end
end

LookupFailed = Class.new(StandardError)

def passing_push_run(sha)
  query = "repos/#{ENV.fetch("GITHUB_REPOSITORY")}/actions/workflows/ci.yml/runs?head_sha=#{sha}&event=push&status=success"
  out, err, status = Open3.capture3("gh", "api", query)
  raise LookupFailed, err.lines.first.to_s.chomp unless status.success?

  JSON.parse(out).fetch("workflow_runs").find do |run|
    run.values_at("head_sha", "event", "conclusion") == [ sha, "push", "success" ]
  end
rescue KeyError, JSON::ParserError, SystemCallError => error
  raise LookupFailed, error.message
end

# A commit that changes only the changelog from a parent CI passed on needs no tests; anything else, or any doubt, does.
def green_skip(github_output:)
  verdicts = git("rev-list", "--parents", "-n", "1", "HEAD").split.drop(1).map do |parent|
    next "#{parent} differs beyond the changelog" unless changelog_only?(git("diff", "--name-status", "--no-renames", parent, "HEAD"))

    begin
      run = passing_push_run(parent)
    rescue LookupFailed => error
      next "the CI lookup for #{parent} failed (#{error.message})"
    end
    next "#{parent} differs only in the changelog, but no passing CI push run was found for it" unless run

    break "skip the tests: HEAD differs from #{parent} only in the changelog, and CI passed on it (#{run["html_url"]})"
  end
  skip = verdicts.is_a?(String)
  message = skip ? verdicts : "run the tests: #{verdicts.join("; ")}"

  puts "green-skip: #{message}"
  File.write(ENV["GITHUB_STEP_SUMMARY"], "green-skip: #{message}\n", mode: "a") if ENV["GITHUB_STEP_SUMMARY"]
  File.write(ENV.fetch("GITHUB_OUTPUT"), skip ? "full=false\nskip=true\n" : "skip=false\n", mode: "a") if github_output
end

root = git("rev-parse", "--show-toplevel").chomp
Dir.chdir(root)

if options[:green_skip]
  green_skip(github_output: options[:github_output])
  exit
end
base = options[:base] || %w[origin/next origin/main].find { |ref| ref?(ref) }
changed = if base
  git("diff", "--name-only", "--no-renames", git("merge-base", base, "HEAD").chomp) +
    git("ls-files", "--others", "--exclude-standard")
else
  git("ls-files")
end
paths = changed.lines(chomp: true).uniq

plan = ChangeLanes.classify(paths)
specs = plan.full ? ChangeLanes.related_specs(paths, root:) : ChangeLanes.specs_for(plan, root:)

puts "lanes: #{plan.full ? "full" : plan.lanes.join(" ")}"

if options[:github_output]
  File.write(ENV.fetch("GITHUB_OUTPUT"), "full=#{plan.full}\nspecs=#{specs.join(" ")}\n", mode: "a")
end

unless options[:run]
  puts specs unless options[:github_output]
  exit
end

if specs.empty?
  puts "test-plan: no specs selected"
  exit
end

if options[:dry_run]
  puts "RAILS_ENV=test bin/rails db:setup", "SKIP_COVERAGE=1 bundle exec rspec #{specs.join(" ")}"
  exit
end

system({ "RAILS_ENV" => "test" }, "bin/rails", "db:setup", exception: true)
exec({ "SKIP_COVERAGE" => "1" }, "bundle", "exec", "rspec", *specs)
